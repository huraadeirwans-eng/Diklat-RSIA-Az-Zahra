rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi Jadwal Pelatihan & Kehadiran Peserta
    match /trainings/{trainingId} {
      allow read, write: if true;
    }
    
    // Koleksi Manajemen Akun & Otoritas SIMRS Diklat
    match /accounts/{accountId} {
      allow read, write: if true;
    }
    
    // Koleksi Master Data Pegawai / Tenaga Medis
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    // Koleksi Pengaturan Sistem & Unit Kerja Kustom
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Log Audit Keamanan
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
